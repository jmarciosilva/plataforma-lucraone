# Modelo de configuração do LUCRAONE.
#
# No Docker este arquivo é copiado para .env na primeira subida, e as
# credenciais de infraestrutura (DB_*, REDIS_*, MAIL_*) são sobrescritas pelo
# environment do docker-compose.yml — o Dotenv do Laravel não sobrepõe
# variáveis que já existem no ambiente.
#
# Fora do Docker, ajuste DB_HOST/REDIS_HOST para 127.0.0.1.

APP_NAME="LUCRAONE — Plataforma SaaS de Automação Comercial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt-BR
APP_FALLBACK_LOCALE=pt-BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# `mysql` é o nome do serviço no compose; fora do Docker use 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lucraone
DB_USERNAME=lucraone
DB_PASSWORD=lucraone_dev_pwd_2026

# cookie, e não database: não existe migration de sessions neste projeto.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# As automações e o resumo de vendas rodam na fila; o container `queue`
# consome esta conexão.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=lucraone_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit captura tudo em desenvolvimento: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lucraone.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
